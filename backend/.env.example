QX_SSID=
QX_COOKIES=
QX_USER_AGENT=
QX_AUTO_REFRESH=true
# When Chrome profile is logged out, fill QUOTEX_EMAIL/PASSWORD on the sign-in page.
# Best-effort — Cloudflare / email OTP can still require a human.
QX_AUTO_LOGIN=true
# Windows VPS: keep a user logged into the desktop so Chrome can open for refresh/login.
# Use deploy/windows/*.ps1 (not systemd). Linux headless still uses Xvfb.
QX_CHROME_PROFILE=
QX_CAPTURE_TIMEOUT=90
# Proactive SSID refresh while still connected (seconds). 0 = only refresh on expiry.
QX_SESSION_REFRESH_SEC=10800
QX_IMPERSONATE=chrome
QX_PROXY=
QUOTEX_EMAIL=you@example.com
QUOTEX_PASSWORD=change-me
QX_OTP=
QUOTEX_LANG=en
QUOTEX_ACCOUNT_MODE=PRACTICE
FEED_ASSETS=ALL_OPEN
# Cap live streams to reduce Quotex disconnects/throttling (0 = no cap).
QX_MAX_STREAM_ASSETS=40
FEED_TIMEFRAMES=60,300,900
REDIS_URL=redis://localhost:6379/0
HEALTH_PORT=8010
INSTRUMENTS_REFRESH_SEC=30
CANDLE_HISTORY_SIZE=500
QX_THROTTLE_COOLDOWN=1200
LOG_LEVEL=INFO

# --- Auth / web_api ---
DATABASE_URL=postgresql+asyncpg://quotex:quotex@localhost:5432/quotex
SESSION_SECRET=change-me-long-random
SESSION_TTL_DAYS=30
COOKIE_NAME=qx_session
COOKIE_SECURE=false
CSRF_COOKIE_NAME=qx_csrf
APP_PUBLIC_URL=http://localhost:5173
AUTH_REQUIRED=true
VERIFY_TOKEN_HOURS=24
RESET_TOKEN_HOURS=2
WEBAPI_CORS=http://localhost:5173
# Dev only: include verify/reset URLs in API JSON when true (keep false in production).
AUTH_EXPOSE_EMAIL_URLS=false

# SMTP (Mailpit locally, or Titan / any SMTP host)
EMAIL_FROM=Quotex Signals <noreply@yourdomain.com>
SMTP_HOST=smtp.titan.email
SMTP_PORT=465
SMTP_TLS=false
SMTP_USER=noreply@yourdomain.com
SMTP_PASSWORD=
# Titan: enable “other apps”, disable mailbox 2FA, then restart the API after edits.

# --- Telegram notification bot ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=quotex_notification_bot
